{
  // 1.1.0 Beta / Public Preview. Publication requires explicit user approval.
  // This file is the single source for version checks, the Git tag, the image tag and release notes.
  "version": "1.1.0",
  "new": [
    "Linux x86_64 AppImage bundles Remember Me, Web UI, MCP, Portable Python, CPU PyTorch and the complete pinned BGE-M3 model for offline inference.",
    "The Launcher provides tray shortcuts and optional login autostart; a minimal Open/Quit window is available when GTK is present without a tray host."
  ],
  "improvements": [
    "Launcher menus and the fallback window support Simplified Chinese and English.",
    "Version checks include published GitHub Pre-releases, exclude Drafts and distinguish Beta and Stable; updates remain manual.",
    "Docker 1.1.0 is an explicit Beta tag; latest remains the verified stable channel. Source master is a development channel."
  ],
  "fixes": [],
  "upgrade": [
    "Stop the service and back up the complete actual data directory before upgrading. Installation methods use different defaults and do not automatically migrate data.",
    "AppImage data defaults to $XDG_DATA_HOME/remember-me-launcher, or ~/.local/share/remember-me-launcher if unset or empty; --data-dir accepts an absolute path.",
    "Verify the AppImage checksum before running it. Moving the file does not move data; re-enable login autostart from the new path if needed.",
    "AppImage requires working FUSE and system GUI libraries; a compatible tray host is needed for the tray icon. Actual GNOME desktop coverage is incomplete across target distributions."
  ],
  "breaking": []
}
